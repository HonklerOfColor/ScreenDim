      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC/CI"
          }
        }
      }
    },
    "DDC/CI ausgeschaltet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC/CI off"
          }
        }
      }
    },
    "DDC/CI kommt über das Dock nicht durch, %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC/CI does not get through the dock, %@."
          }
        }
      }
    },
    "DDC/CI kommt über den Adapter nicht durch, %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC/CI does not get through the adapter, %@."
          }
        }
      }
    },
    "DDC/CI regelt die Hintergrundbeleuchtung des Monitors. Gamma skaliert die Farbkurve des Displays, Overlay legt ein halbtransparentes Fenster darüber." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC/CI controls the display's backlight. Gamma scales the display's color curve, Overlay places a semi-transparent window over it."
          }
        }
      }
    },
    "DDC/CI stellt die Hintergrundbeleuchtung des Monitors ein. Gamma und Overlay dimmen per Software; die Hintergrundbeleuchtung bleibt dann, wie sie ist. Die des eingebauten Displays regelst du mit den Helligkeitstasten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDC/CI sets the display's backlight. Gamma and Overlay dim in software; the backlight then stays as it is. The built-in display's backlight is controlled with the brightness keys."
          }
        }
      }
    },
    "DDC/CI wird geprüft …" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking DDC/CI…"
          }
        }
      }
    },
